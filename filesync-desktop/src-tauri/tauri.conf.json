{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "filesync-desktop",
  "version": "0.1.0",
  "identifier": "com.sunyuanling.filesync-desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "云梯",
        "width": 800,
        "height": 600,
        "minWidth": 640,
        "minHeight": 480,
        "devtools": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "Utility",
    "shortDescription": "私有云文件同步",
    "longDescription": "云梯：个人自托管的多端文件同步与传输桌面客户端。",
    "linux": {
      "deb": {
        "desktopTemplate": "linux/filesync-desktop.desktop"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "languages": ["SimpChinese", "English"],
        "installerHooks": "./nsis/installer.nsh"
      }
    }
  }
}