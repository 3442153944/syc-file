{
    "version": "0.2.0",
    "configurations": [
        
        {
            "name": "后端 (new_server)",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}/new_server/cmd",
            "cwd": "${workspaceFolder}/new_server",
            "env": {
                "CGO_ENABLED": "1",
                "CC": "gcc",
                "PATH": "/usr/local/go/bin:${env:PATH}"
            },
            "preLaunchTask": "后端: prepare",
            "postDebugTask": "后端: 恢复系统服务"
        },
        {
            "name": "桌面端 (Tauri dev)",
            "type": "node",
            "request": "launch",
            "runtimeExecutable": "pnpm",
            "runtimeArgs": [
                "tauri",
                "dev"
            ],
            "cwd": "${workspaceFolder}/filesync-desktop",
            "console": "integratedTerminal",
            "skipFiles": [
                "<node_internals>/**"
            ]
        },
        {
            "name": "Web端 (Vite dev)",
            "type": "node",
            "request": "launch",
            "runtimeExecutable": "pnpm",
            "runtimeArgs": [
                "dev"
            ],
            "cwd": "${workspaceFolder}/filesync-desktop",
            "console": "integratedTerminal",
            "serverReadyAction": {
                "pattern": "Local:\\s+(https?://\\S+)",
                "uriFormat": "%s",
                "action": "openExternally"
            },
            "skipFiles": [
                "<node_internals>/**"
            ]
        },
        {
            "name": "构建: filecore (Linux)",
            "type": "node",
            "request": "launch",
            "noDebug": true,
            "runtimeExecutable": "bash",
            "runtimeArgs": [
                "file_lib/build.sh"
            ],
            "cwd": "${workspaceFolder}/new_server",
            "console": "integratedTerminal",
            "skipFiles": [
                "<node_internals>/**"
            ]
        },
        {
            "name": "构建: 桌面端 (deb)",
            "type": "node",
            "request": "launch",
            "noDebug": true,
            "runtimeExecutable": "pnpm",
            "runtimeArgs": [
                "tauri",
                "build",
                "--bundles",
                "deb"
            ],
            "cwd": "${workspaceFolder}/filesync-desktop",
            "console": "integratedTerminal",
            "skipFiles": [
                "<node_internals>/**"
            ]
        },
        {
            "name": "构建: 后端 Docker 镜像",
            "type": "node",
            "request": "launch",
            "noDebug": true,
            "runtimeExecutable": "bash",
            "runtimeArgs": [
                "docker/build.sh"
            ],
            "cwd": "${workspaceFolder}/new_server",
            "console": "integratedTerminal",
            "skipFiles": [
                "<node_internals>/**"
            ]
        },
        {
            "name": "部署: 后端 (本机 systemd)",
            "type": "node",
            "request": "launch",
            "noDebug": true,
            "runtimeExecutable": "bash",
            "runtimeArgs": [
                "deploy.sh"
            ],
            "cwd": "${workspaceFolder}/new_server",
            "console": "integratedTerminal",
            "skipFiles": [
                "<node_internals>/**"
            ]
        },
        {
            "name": "部署: Web 端构建并发布到 nginx",
            "type": "node",
            "request": "launch",
            "noDebug": true,
            "runtimeExecutable": "bash",
            "runtimeArgs": [
                "scripts/deploy-web.sh"
            ],
            "cwd": "${workspaceFolder}/filesync-desktop",
            "console": "integratedTerminal",
            "skipFiles": [
                "<node_internals>/**"
            ]
        },
        {
            "name": "部署: 桌面端 (Linux) 构建并安装",
            "type": "node",
            "request": "launch",
            "noDebug": true,
            "runtimeExecutable": "bash",
            "runtimeArgs": [
                "scripts/install-linux-desktop.sh",
                "--pin",
                "--desktop"
            ],
            "cwd": "${workspaceFolder}/filesync-desktop",
            "console": "integratedTerminal",
            "skipFiles": [
                "<node_internals>/**"
            ]
        }
    ]
}